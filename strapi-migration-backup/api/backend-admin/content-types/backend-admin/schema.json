{
  "kind": "collectionType",
  "collectionName": "backend_admins",
  "info": {
    "singularName": "backend-admin",
    "pluralName": "backend-admins",
    "displayName": "Backend Admin"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "username": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "password": {
      "type": "password",
      "required": true
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "backend_role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::backend-role.backend-role",
      "inversedBy": "backend_admins"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_login": {
      "type": "datetime"
    }
  }
}
