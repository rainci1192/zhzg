{
  "kind": "collectionType",
  "collectionName": "operation_logs_v2",
  "info": {
    "singularName": "operation-log",
    "pluralName": "operation-logs",
    "displayName": "Operation Log",
    "description": "自定义后台管理操作审计日志"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "actor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::backend-admin.backend-admin"
    },
    "actor_name": { "type": "string" },
    "actor_email": { "type": "email" },
    "actor_role": { "type": "string" },
    "action": { "type": "string", "required": true },
    "module": { "type": "string", "required": true },
    "target_type": { "type": "string" },
    "target_id": { "type": "string" },
    "target_label": { "type": "string" },
    "method": { "type": "string" },
    "path": { "type": "string" },
    "ip_address": { "type": "string" },
    "user_agent": { "type": "text" },
    "status_code": { "type": "integer" },
    "result": { "type": "enumeration", "enum": ["success", "failed"], "default": "success" },
    "details": { "type": "json" }
  }
}
