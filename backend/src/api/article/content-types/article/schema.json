{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "文章管理 - 支持多级审核流程"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "review_status": {
      "type": "enumeration",
      "required": true,
      "default": "draft",
      "enum": [
        "draft",
        "pending_level1",
        "rejected_level1",
        "pending_level2",
        "rejected_level2",
        "pending_republish",
        "rejected_republish",
        "approved_pending_publish",
        "published",
        "unpublished",
        "pending_admin",
        "rejected_admin",
        "pending_leader",
        "rejected_leader",
        "approved"
      ]
    },
    "publish_time": {
      "type": "datetime"
    },
    "view_count": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "is_top": {
      "type": "boolean",
      "default": false
    },
    "content": {
      "type": "richtext"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "attachment_names": {
      "type": "json"
    },
    "primary_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "primary_articles"
    },
    "secondary_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "secondary_articles"
    },
    "created_by_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "created_by_admin": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::backend-admin.backend-admin"
    },
    "level1_reviewer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::backend-admin.backend-admin"
    },
    "level2_reviewer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::backend-admin.backend-admin"
    },
    "reviewed_by_admin": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "reviewed_by_leader": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "level1_review_comment": {
      "type": "text"
    },
    "level1_review_date": {
      "type": "datetime"
    },
    "level2_review_comment": {
      "type": "text"
    },
    "level2_review_date": {
      "type": "datetime"
    },
    "admin_review_comment": {
      "type": "text"
    },
    "admin_review_date": {
      "type": "datetime"
    },
    "leader_review_comment": {
      "type": "text"
    },
    "leader_review_date": {
      "type": "datetime"
    },
    "rejection_reason": {
      "type": "text"
    }
  }
}
