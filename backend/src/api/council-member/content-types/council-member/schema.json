{
  "kind": "collectionType",
  "collectionName": "council_members",
  "info": {
    "singularName": "council-member",
    "pluralName": "council-members",
    "displayName": "Council Member"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "website": {
      "type": "string"
    },
    "is_council": {
      "type": "boolean",
      "default": true
    },
    "intro": {
      "type": "richtext"
    }
  }
}
