{
  "kind": "collectionType",
  "collectionName": "research_institutions",
  "info": {
    "singularName": "research-institution",
    "pluralName": "research-institutions",
    "displayName": "Research Institution",
    "description": "科研机构"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "summary": {
      "type": "richtext"
    }
  }
}
