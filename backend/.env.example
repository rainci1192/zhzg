# Copy to .env, generate unique random secrets, and never commit the real .env.
HOST=0.0.0.0
PORT=1337
APP_KEYS="replace-with-random-key-1,replace-with-random-key-2"
API_TOKEN_SALT=replace-with-a-unique-random-value
ADMIN_JWT_SECRET=replace-with-a-unique-random-value
TRANSFER_TOKEN_SALT=replace-with-a-unique-random-value
JWT_SECRET=replace-with-a-unique-random-value
ENCRYPTION_KEY=replace-with-a-unique-random-value

# Production: explicitly set the public website/admin origins, comma-separated.
# Example: CORS_ORIGINS=https://www.example.edu.cn,https://admin.example.edu.cn
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
