+
+/* 二级页面延续首页的深海蓝、浅蓝与留白节奏 */
+.site-subpage { background: radial-gradient(circle at 92% 10%, #e4f1fa 0, transparent 30%), #f5f8fb !important; }
+.site-page-hero { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: #073864; }
+.site-page-hero::before { content: ''; position: absolute; z-index: -2; inset: 0; background: url('/images/zh-banner3.png') center 46% / cover no-repeat; transform: scale(1.025); transition: transform .8s ease; }
+.site-page-hero:hover::before { transform: scale(1.06); }
+.site-page-hero::after { content: ''; position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(3,30,64,.94), rgba(4,53,101,.83) 54%, rgba(5,59,106,.53)), linear-gradient(0deg, rgba(2,29,59,.5), transparent); }
+.site-page-hero-inner { width: min(100% - 64px, 1280px); margin: auto; min-height: 275px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 48px 0 38px; }
+.site-page-eyebrow { display: inline-flex; align-items: center; gap: 12px; color: #a5d8f5; font-size: 12px; font-weight: 700; letter-spacing: .15em; }
+.site-page-eyebrow::before { content: ''; display: block; width: 28px; height: 2px; background: #91d5fb; }
+.site-page-hero h1 { margin: 17px 0 24px; font-size: clamp(33px, 4vw, 55px); line-height: 1.2; font-weight: 700; letter-spacing: .06em; text-wrap: balance; }
+.site-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; max-width: 100%; font-size: 13px; color: #c6def0; }
+.site-breadcrumb-segment { display: inline-flex; align-items: center; min-width: 0; gap: 7px; }
+.site-breadcrumb a { transition: color .2s; }
+.site-breadcrumb a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
+.site-breadcrumb-divider { opacity: .5; }
+.site-breadcrumb-current { color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: min(55vw, 600px); }
+.site-page-body { padding-top: 55px !important; padding-bottom: 95px !important; }
+.site-column-layout { gap: clamp(24px, 3vw, 44px) !important; align-items: flex-start; }
+.site-column-aside { width: 245px !important; }
+.site-column-layout > .flex-1 { min-width: 0; }
+.site-sidebar { overflow: hidden; border: 1px solid #e0eaf3; background: white; box-shadow: 0 12px 30px rgba(12,55,96,.07); }
+.site-sidebar-heading { padding: 28px 28px 24px; color: #fff; background: linear-gradient(125deg, #075294, #063666); }
+.site-sidebar-heading::before { content: 'SECTION / 栏目导航'; display: block; margin-bottom: 8px; font-size: 10px; font-weight: 700; letter-spacing: .15em; color: #b9dcf1; }
